{
  "name": "gc-helper",
  "version": "1.0.0",
  "description": "Zero-dependency auto-configurator, connection auditor, and status hub for AI coding harnesses (Claude Code, Codex, Hermes, VS Code, Claude Desktop, OpenClaw, OpenCode, OMP).",
  "type": "module",
  "main": "./src/cli.mjs",
  "bin": {
    "gc-helper": "./bin/gc-helper.mjs",
    "gc": "./bin/gc-helper.mjs"
  },
  "scripts": {
    "start": "node bin/gc-helper.mjs",
    "status": "node bin/gc-helper.mjs status",
    "sync": "node bin/gc-helper.mjs sync",
    "audit": "node bin/gc-helper.mjs audit",
    "test": "node test/test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "gc-helper",
    "ghostcli",
    "claude-code",
    "codex",
    "vscode",
    "claude-desktop",
    "hermes-agent",
    "openclaw",
    "opencode",
    "omp",
    "ai-agent",
    "llm-proxy",
    "developer-tools"
  ],
  "author": "bepaldes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bepaldes/gc-helper.git"
  }
}
